    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
           to the ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141592653589793 0 0</modelXYZToAirplaneXForwardZDown>

      <!-- Transform from the Gazebo world frame (ENU)
           to the ArduPilot world frame (NED) -->
      <gazeboXYZToNED>0 0 0 3.141592653589793 0 1.5707963267948966</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>imu_sensor</imuName>

      <!-- Thrusters -->
      <control channel="0">
        <jointName>thruster1_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster1_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="1">
        <jointName>thruster2_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster2_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="2">
        <jointName>thruster3_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster3_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="3">
        <jointName>thruster4_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster4_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="4">
        <jointName>thruster5_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster5_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="5">
        <jointName>thruster6_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster6_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="6">
        <jointName>thruster7_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster7_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="7">
        <jointName>thruster8_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2/joint/thruster8_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>

     <!--
        Configure ArduSub to use a SITL rangefinder backend:
        param set RNGFND1_TYPE 100        # Type = SITL
        param set RNGFND1_FUNCTION 0      # Function = LINEAR
        param set RNGFND1_MIN_CM 20       # Min distance is 0.5m
        param set RNGFND1_MAX_CM 5000     # Max distance is 50m
        param set RNGFND1_ORIENT 25       # Down
        param set RNGFND1_POS_X -0.15
        param set RNGFND1_POS_Y 0
        param set RNGFND1_POS_Z -0.095
      -->
      <sensor>
        <type>sonar</type>
        <index>1</index>
        <topic>sonar_link/sensor/sonar</topic>
      </sensor>

    </plugin>

    <!-- Left Camera link -->
    <link name="left_camera_link">
      <!-- <pose>0.19 0.1 -0.201 0 1.5707963267948966 0</pose> -->
      <pose>0.19 0.1 -0.201 -1.5707963267948966 0 -1.5707963267948966</pose>
       <sensor name="left_camera" type="camera">
        <pose>0 0 0 0 -1.5707963267948966 1.5707963267948966</pose>
        <camera>
          <horizontal_fov>1.6</horizontal_fov>
          <image>
            <width>1600</width>
            <height>1200</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>10</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>25</update_rate>
        <visualize>true</visualize>
        <topic>Passive/left/image_raw</topic>
        <!-- Tell the ros_gz_image::image_bridge node to set the ROS2 frame_id to "camera_sensor".
             This tag doesn't appear in the SDF spec, so `gz sdf -c` will generate a warning which you can ignore. -->
        <gz_frame_id>left_camera_link</gz_frame_id>
      </sensor>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Attach camera_link to base_link -->
    <joint name="left_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_camera_link</child>
    </joint>

    <!-- Right Camera link -->
    <link name="right_camera_link">
      <!-- <pose>0.19 0.1 -0.201 0 1.5707963267948966 0</pose> -->
      <pose>0.19 -0.1 -0.201 -1.5707963267948966 0 -1.5707963267948966</pose>
      <sensor name="right_sim_camera" type="camera">
        <pose>0 0 0 0 -1.5707963267948966 1.5707963267948966</pose>
        <camera>
          <horizontal_fov>1.6</horizontal_fov>
          <image>
            <width>1600</width>
            <height>1200</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>10</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>25</update_rate>
        <visualize>true</visualize>
        <topic>Passive/right/image_raw</topic>
        <!-- Tell the ros_gz_image::image_bridge node to set the ROS2 frame_id to "camera_sensor".
             This tag doesn't appear in the SDF spec, so `gz sdf -c` will generate a warning which you can ignore. -->
        <gz_frame_id>right_camera_link</gz_frame_id>
      </sensor>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Attach camera_link to base_link -->
    <joint name="right_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_camera_link</child>
    </joint>

    <link name='sonar_link'>
      <pose>-0.15 0 -0.095 0 0 0</pose>
      <inertial>
        <mass>0.133</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <visual name="ping_visual">
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.024</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.2 0.0 1.0</ambient>
          <diffuse>0.0 0.2 0.0 1.0</diffuse>
        </material>
      </visual>

      <!-- Use a gpu_lidar sensor to emulate a Ping sonar sensor. The sensor is configured to generate 5x5=25 range
           values in a pretty tight square. (The beam angle is 17 degrees in x or y, or 24 degrees diagonally.)
           ardupilot_gazebo will pick the minimum value and send it as a rangefinder reading. -->
      <sensor name='ping_sonar' type='gpu_lidar'>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>
        <topic>sonar_link/sensor/sonar</topic>
        <pose>0 0 0 0 1.5707963267948966 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>50</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.1</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <joint name='sonar_joint' type='revolute'>
      <parent>base_link</parent>
      <child>sonar_link</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Publish the ground-truth pose for rviz -->
    <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>bluerov2</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
