<?xml version="1.0"?>
<robot name="orca5_1">

  <!-- Base link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="0.1024" ixy="0.0" ixz="0.0" iyy="0.1840" iyz="0.0" izz="0.2785"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://orca_bringup/models/orca5/meshes/bluerov2.dae" scale="0.025 0.025 0.025"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.457 0.338 0.0673"/>
      </geometry>
    </collision>
  </link>

  <!-- Materials -->
  <material name="camera_blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="ping_green">
    <color rgba="0.0 0.5 0.0 1.0"/>
  </material>

  <!-- Camera link, rendered as a box so I can see the rotation -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.03 0.02"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.035 -0.08 -0.085" rpy="0 1.5707963267948966 0.3"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Ping sonar link -->
  <link name="ping_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.133"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.035" radius="0.024"/>
      </geometry>
      <material name="ping_green"/>
    </visual>
  </link>

  <joint name="ping_joint" type="fixed">
    <origin xyz="0.035 0.08 -0.085" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="ping_link"/>
  </joint>

</robot>
